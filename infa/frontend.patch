+<template>
+  <PageContainer card>
+    <el-result icon="info" :title="title" :sub-title="region">
+      <template #extra>
+        <p class="hint">{{ $t('infa.linkPending') }}</p>
+        <p class="hint">{{ $t('infa.linkHow') }}</p>
+      </template>
+    </el-result>
+  </PageContainer>
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+import PageContainer from '@/components/PageContainer/index.vue'
+import { useRoute } from 'vue-router'
+
+// 監控子項目尚未設定網址時的佔位頁。
+// 設定方式：系統設置 → 選單管理 → 編輯該子項目，把「路由地址」改成 https:// 開頭的網址。
+// 側邊欄遇到外部網址會直接以新分頁開啟，不再進到這頁。
+defineOptions({ name: 'InfaLink' })
+
+const route = useRoute()
+const title = computed(() => String(route.meta.title ?? ''))
+// matched: [Layout(系統工具), 區域, 子項目]
+const region = computed(() => {
+  const parent = route.matched[route.matched.length - 2]
+  return String(parent?.meta?.title ?? '')
+})
+</script>
+
+<style scoped>
+.hint {
+  margin: 4px 0;
+  color: var(--el-text-color-secondary);
+}
+</style>
