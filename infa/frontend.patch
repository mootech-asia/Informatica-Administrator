+<template>
+  <!-- Live particle-wave backdrop; see wave.js -->
+  <canvas ref="canvas" class="particle-wave" aria-hidden="true" />
+</template>
+
+<script>
+import { startParticleWave } from './wave'
+
+export default {
+  name: 'ParticleWave',
+  mounted() {
+    this.stop = startParticleWave(this.$refs.canvas)
+  },
+  beforeUnmount() {
+    this.stop?.()
+  }
+}
+</script>
+
+<style scoped>
+.particle-wave {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  display: block;
+  pointer-events: none;
+}
