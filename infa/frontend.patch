diff --git a/src/components/ParticleWave/wave.js b/src/components/ParticleWave/wave.js
new file mode 100644
index 0000000..9974d15
--- /dev/null
+++ b/src/components/ParticleWave/wave.js
@@ -0,0 +1,245 @@
+/**
+ * Particle-wave backdrop for the login hero, drawn live on a canvas.
+ *
+ * Three layers, back to front:
+ *   - a dotted floor whose lines run into a vanishing point on the horizon;
+ *   - bundles of fine luminous strands that rise on both sides and settle
+ *     into the horizon glow in the middle;
+ *   - out-of-focus bokeh drifting in the foreground.
+ *
+ * Everything moves on one slow clock (SPEED) so the scene reads as calm and
+ * steady rather than busy.
+ */
+
+const SPEED = 0.32 // global time scale; lower = calmer
+
+// Floor
+const FLOOR_COLS = 150
+const FLOOR_ROWS = 46
+const NEAR = 40
+const FAR = 2400
+const FOCAL = 520
+const CAM_Y = 150 // camera height above the floor
+
+// Strands
+const STRANDS = 46
+const STRAND_STEPS = 160
+
+const rand = (a, b) => a + Math.random() * (b - a)
+
+export function startParticleWave(canvas) {
+  const ctx = canvas.getContext('2d')
+  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
+  const bokeh = []
+  const strands = []
+  let w = 0
+  let h = 0
+  let horizon = 0
+  let raf = 0
+
+  for (let i = 0; i < STRANDS; i++) {
+    strands.push({
+      d: i / (STRANDS - 1), // 0 = top of the bundle, 1 = bottom
+      phase: rand(0, Math.PI * 2),
+      amp: rand(0.7, 1.3),
+      dotEvery: 3 + Math.floor(rand(0, 4))
+    })
+  }
+
+  function resize() {
+    const dpr = Math.min(window.devicePixelRatio || 1, 2)
+    w = canvas.clientWidth
+    h = canvas.clientHeight
+    horizon = h * 0.56
+    canvas.width = Math.round(w * dpr)
+    canvas.height = Math.round(h * dpr)
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
+    bokeh.length = 0
+    const n = Math.round(w * h / 26000)
+    for (let i = 0; i < n; i++) {
+      const big = Math.random() < 0.3
+      bokeh.push({
+        x: rand(0, w),
+        y: big ? rand(h * 0.65, h * 1.02) : rand(h * 0.08, h),
+        r: big ? rand(6, 20) : rand(1, 2.6),
+        vx: rand(-0.06, 0.06),
+        vy: rand(-0.08, -0.02),
+        a: big ? rand(0.12, 0.35) : rand(0.3, 0.8),
+        p: rand(0, Math.PI * 2)
+      })
+    }
+  }
+
+  // Height of the bundle above the horizon at u (-1..1 across the screen):
+  // low in the centre, cresting near the sides, easing off at the edges.
+  function lift(u) {
+    const a = Math.min(1, Math.abs(u) / 0.9)
+    return a * a * (3 - 2 * a)
+  }
+
+  function background() {
+    const g = ctx.createLinearGradient(0, 0, 0, h)
+    g.addColorStop(0, '#01030c')
+    g.addColorStop(0.45, '#04133a')
+    g.addColorStop(0.62, '#062463')
+    g.addColorStop(1, '#020b26')
+    ctx.fillStyle = g
+    ctx.fillRect(0, 0, w, h)
+
+    // Wide soft glow plus a flattened bright core on the horizon.
+    const r = Math.max(w, h) * 0.6
+    const glow = ctx.createRadialGradient(w / 2, horizon, 0, w / 2, horizon, r)
+    glow.addColorStop(0, 'rgba(50,140,255,0.55)')
+    glow.addColorStop(0.3, 'rgba(25,90,230,0.22)')
+    glow.addColorStop(1, 'rgba(0,0,0,0)')
+    ctx.fillStyle = glow
+    ctx.fillRect(0, 0, w, h)
+
+    ctx.save()
+    ctx.translate(w / 2, horizon)
+    ctx.scale(1, 0.16)
+    const core = ctx.createRadialGradient(0, 0, 0, 0, 0, w * 0.32)
+    core.addColorStop(0, 'rgba(120,200,255,0.75)')
+    core.addColorStop(0.4, 'rgba(60,150,255,0.25)')
+    core.addColorStop(1, 'rgba(0,0,0,0)')
+    ctx.fillStyle = core
+    ctx.fillRect(-w, -w, w * 2, w * 2)
+    ctx.restore()
+  }
+
+  // Floor point at screen-relative column u (-1.3..1.3) and depth z.
+  function floorPoint(u, z, t) {
+    const s = FOCAL / z
+    const wave =
+      Math.sin(u * 3.2 + z * 0.0035 - t * 0.9) * 22 +
+      Math.sin(z * 0.006 + t * 0.7 + u * 1.5) * 14
+    const y = wave * (0.5 + u * u) + u * u * 30
+    const k = s / (FOCAL / 260) // u = ±1 reaches the screen edge at z = 260
+    return [w / 2 + u * k * w * 0.5, horizon + (CAM_Y - y) * s * (h / 900), s]
+  }
+
+  function drawFloor(t) {
+    const zs = []
+    for (let r = 0; r < FLOOR_ROWS; r++) {
+      const k = r / (FLOOR_ROWS - 1)
+      zs.push(NEAR + Math.pow(k, 1.7) * (FAR - NEAR))
+    }
+
+    // Lines running into the vanishing point give the floor its depth.
+    ctx.lineWidth = 0.7
+    for (let c = 0; c < FLOOR_COLS; c++) {
+      const u = (c / (FLOOR_COLS - 1) - 0.5) * 4
+      const centre = 1 - Math.min(1, Math.abs(u) / 1.6)
+      ctx.beginPath()
+      for (let r = 0; r < FLOOR_ROWS; r++) {
+        const [x, y] = floorPoint(u, zs[r], t)
+        if (r) ctx.lineTo(x, y)
+        else ctx.moveTo(x, y)
+      }
+      ctx.strokeStyle = `rgba(70,150,255,${0.05 + 0.13 * centre})`
+      ctx.stroke()
+    }
+
+    for (let r = FLOOR_ROWS - 1; r >= 0; r--) {
+      const z = zs[r]
+      const fade = 1 - (r / (FLOOR_ROWS - 1)) * 0.6
+      for (let c = 0; c < FLOOR_COLS; c++) {
+        const u = (c / (FLOOR_COLS - 1) - 0.5) * 4
+        const [x, y, s] = floorPoint(u, z, t)
+        if (x < -10 || x > w + 10 || y < horizon - 40 || y > h + 10) continue
+        const tw = 0.65 + 0.35 * Math.sin(t * 1.4 + c * 1.9 + r * 2.7)
+        ctx.fillStyle = `rgba(70,165,255,${0.75 * fade * tw})`
+        ctx.beginPath()
+        ctx.arc(x, y, Math.max(0.6, s * 1.6), 0, Math.PI * 2)
+        ctx.fill()
+      }
+    }
+  }
+
+  function strandY(st, u, t) {
+    const L = lift(u)
+    const swell =
+      Math.sin(u * 2.4 - t * 0.55 + st.phase * 0.15) * 0.05 +
+      Math.sin(u * 5.1 + t * 0.4 + st.d * 2.2) * 0.022 * st.amp
+    const spread = (st.d - 0.5) * (0.03 + L * 0.2) // bundle fans out where it rises
+    return horizon - h * (L * 0.2 + swell * (0.4 + L) - spread)
+  }
+
+  function drawStrands(t) {
+    for (const st of strands) {
+      const edge = 1 - Math.abs(st.d - 0.5) * 1.4
+      ctx.beginPath()
+      for (let i = 0; i <= STRAND_STEPS; i++) {
+        const u = (i / STRAND_STEPS) * 2.2 - 1.1
+        const x = w / 2 + u * w * 0.5
+        const y = strandY(st, u, t)
+        if (i) ctx.lineTo(x, y)
+        else ctx.moveTo(x, y)
+      }
+      ctx.strokeStyle = `rgba(80,170,255,${0.06 + 0.16 * edge})`
+      ctx.lineWidth = 0.9
+      ctx.stroke()
+
+      // Particles riding along the strand, drifting slowly sideways.
+      const drift = (t * 0.02 + st.phase) % 1
+      for (let i = 0; i <= STRAND_STEPS; i += st.dotEvery) {
+        const u = (((i / STRAND_STEPS) + drift) % 1) * 2.2 - 1.1
+        const L = lift(u)
+        const x = w / 2 + u * w * 0.5
+        const y = strandY(st, u, t)
+        const tw = 0.5 + 0.5 * Math.sin(t * 1.6 + i * 0.9 + st.phase)
+        const a = (0.25 + 0.75 * L) * (0.4 + 0.6 * edge) * tw
+        ctx.fillStyle = `rgba(120,200,255,${a})`
+        ctx.beginPath()
+        ctx.arc(x, y, 0.8 + L * 1.6, 0, Math.PI * 2)
+        ctx.fill()
+      }
+    }
+  }
+
+  function drawBokeh(t) {
+    for (const b of bokeh) {
+      if (!reduceMotion) {
+        b.x += b.vx
+        b.y += b.vy
+        if (b.y < -30) { b.y = h + 30; b.x = rand(0, w) }
+        if (b.x < -30) b.x = w + 30
+        else if (b.x > w + 30) b.x = -30
+      }
+      const a = b.a * (0.7 + 0.3 * Math.sin(t * 0.6 + b.p))
+      const g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r)
+      g.addColorStop(0, `rgba(70,160,255,${a})`)
+      g.addColorStop(0.7, `rgba(70,160,255,${a * 0.6})`)
+      g.addColorStop(1, 'rgba(70,160,255,0)')
+      ctx.fillStyle = g
+      ctx.beginPath()
+      ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2)
+      ctx.fill()
+    }
+  }
+
+  function frame(ms) {
+    if (!reduceMotion) raf = requestAnimationFrame(frame)
+    if (!w || !h) return
+    const t = (ms / 1000) * SPEED
+    background()
+    ctx.globalCompositeOperation = 'lighter'
+    drawFloor(t)
+    drawStrands(t)
+    drawBokeh(t)
+    ctx.globalCompositeOperation = 'source-over'
+  }
+
+  // Under reduced motion, draw a single still frame on each resize.
+  const observer = new ResizeObserver(() => {
+    resize()
+    if (reduceMotion) frame(8000)
+  })
+  observer.observe(canvas)
+  if (!reduceMotion) raf = requestAnimationFrame(frame)
+
+  return () => {
+    cancelAnimationFrame(raf)
+    observer.disconnect()
+  }
+}
diff --git a/src/demo/adapter.ts b/src/demo/adapter.ts
new file mode 100644
index 0000000..653400a
--- /dev/null
+++ b/src/demo/adapter.ts
@@ -0,0 +1,83 @@
+import type { AxiosAdapter, InternalAxiosRequestConfig } from 'axios'
+import fixtures from './fixtures.json'
+import { i18n } from '@/lang'
+
+/**
+ * 展示版（VUE_APP_DEMO=1）專用：不連後端，改用錄下來的 API 回應。
+ *
+ * fixtures.json 是在真的 go-admin 後端上，以 admin / demo 兩個帳號點過每個頁面
+ * 錄下的 GET 回應（錄製方式見 INFA repo 的 infa/README.md）。登入時依帳號決定之後用哪一組回應，
+ * 所以兩個帳號看到的選單不同，和正式環境一致。
+ *
+ * 新增、修改、刪除一律回成功但不保存，並提示這是展示版。
+ */
+
+type Fixtures = Record<string, Record<string, unknown>>
+const sets = fixtures as Fixtures
+
+const ACCOUNTS: Record<string, string> = { admin: '123456', demo: 'demo1234' }
+const TOKEN_PREFIX = 'demo-token-'
+
+const ok = (data: unknown = null, msg = '') => ({ code: 200, msg, data, requestId: 'demo' })
+
+const accountOf = (config: InternalAxiosRequestConfig) => {
+  const auth = String(config.headers?.Authorization ?? '')
+  const name = auth.replace(/^Bearer\s+/, '').replace(TOKEN_PREFIX, '')
+  return sets[name] ? name : 'admin'
+}
+
+const pathAndQuery = (config: InternalAxiosRequestConfig) => {
+  const url = new URL(config.url ?? '', 'http://demo')
+  const params = { ...Object.fromEntries(url.searchParams), ...(config.params ?? {}) } as Record<string, unknown>
+  const query = Object.keys(params)
+    .filter(k => params[k] !== undefined && params[k] !== '')
+    .sort()
+    .map(k => `${k}=${params[k]}`)
+    .join('&')
+  return { path: url.pathname, query }
+}
+
+/** 找不到完全相符的錄製結果時，用同一路徑任何一筆錄製結果代替（例如換頁、搜尋）。 */
+const lookup = (set: Record<string, unknown>, path: string, query: string) => {
+  const exact = set[query ? `${path}?${query}` : path]
+  if (exact) return exact
+  const key = Object.keys(set).find(k => k.split('?')[0] === path)
+  if (key) return set[key]
+  // /menu/:id 沒錄到時，從整棵選單樹裡找
+  const menu = path.match(/^\/api\/v1\/menu\/(\d+)$/)
+  if (menu) {
+    const tree = (set['/api/v1/menu'] as { data?: unknown[] })?.data ?? []
+    const find = (nodes: unknown[]): unknown => {
+      for (const n of nodes as { menuId: number, children?: unknown[] }[]) {
+        if (n.menuId === Number(menu[1])) return n
+        const hit = n.children && find(n.children)
+        if (hit) return hit
+      }
+    }
+    return ok(find(tree) ?? null)
+  }
+  return undefined
+}
+
+const respond = (config: InternalAxiosRequestConfig, data: unknown) =>
+  Promise.resolve({ data, status: 200, statusText: 'OK', headers: {}, config })
+
+export const demoAdapter: AxiosAdapter = config => {
+  const method = (config.method ?? 'get').toLowerCase()
+  const { path, query } = pathAndQuery(config)
+
+  if (path === '/api/v1/login' && method === 'post') {
+    const body = typeof config.data === 'string' ? JSON.parse(config.data) : config.data ?? {}
+    if (ACCOUNTS[body.username] !== body.password) {
+      return respond(config, { code: 400, msg: i18n.global.t('infa.demoLogin') })
+    }
+    return respond(config, { code: 200, token: TOKEN_PREFIX + body.username, expire: '2099-01-01T00:00:00+08:00' })
+  }
+
+  if (method !== 'get') {
+    return respond(config, ok(null, i18n.global.t('infa.demoNotSaved')))
+  }
+
+  const hit = lookup(sets[accountOf(config)], path, query)
+  return respond(config, hit ?? ok(null))
+}
