+  Infa10108: NO_LOGIN, // Looking glass
+  Infa10109: NO_LOGIN, // Streaming wall
+  Infa10110: NO_LOGIN, // haproxystat
+  Infa10111: twNtop,
+  // Infa10112 Wazuh：截圖待補
+  // JPIDC
+  Infa10201: jpCacti,
+  Infa10202: jpZabbix,
+  // Infa10203 PRTG：截圖待補
+  Infa10204: graylog
+}
