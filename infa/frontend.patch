diff --git a/.env.demo b/.env.demo
new file mode 100644
index 0000000..b4b14f0
--- /dev/null
+++ b/.env.demo
@@ -0,0 +1,9 @@
+# 展示版（GitHub Pages）：不連後端，API 回應來自 src/demo/fixtures.json
+# 建置：pnpm vite build --mode demo
+ENV = 'production'
+VUE_APP_DEMO = '1'
+VUE_APP_BASE_API = ''
+VUE_APP_LOCALE = 'zh-CN'
+VUE_APP_GA_ID = ''
+VITE_BASE = './'
+SASS_SILENCE_DEPRECATIONS = 'legacy-js-api'
