+        <h2>{{ title }}</h2>
+        <span class="infa-link__region">{{ region }}</span>
+      </div>
+
+      <figure v-if="preview" class="infa-link__preview">
+        <el-image :src="preview" :preview-src-list="[preview]" fit="contain" :alt="title" />
+        <figcaption>{{ $t('infa.previewCaption') }}</figcaption>
+      </figure>
+      <el-alert v-else-if="noLogin" :title="$t('infa.noLogin')" type="info" :closable="false" show-icon />
+      <el-alert v-else :title="$t('infa.previewPending')" type="info" :closable="false" show-icon />
+
+      <p class="hint">{{ $t('infa.linkPending') }} {{ $t('infa.linkHow') }}</p>
+    </div>
+  </PageContainer>
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+import PageContainer from '@/components/PageContainer/index.vue'
+import { useRoute } from 'vue-router'
+import { loginPreviews, NO_LOGIN } from './previews'
+
+// 監控子項目尚未設定網址時的佔位頁：顯示該系統登入畫面的截圖（見 previews.ts）。
+// 設定方式：系統設置 → 選單管理 → 編輯該子項目，把「路由地址」改成 https:// 開頭的網址。
+// 側邊欄遇到外部網址會直接以新分頁開啟，不再進到這頁。
+defineOptions({ name: 'InfaLink' })
+
+const route = useRoute()
+const title = computed(() => String(route.meta.title ?? ''))
+// matched: [Layout(系統工具), 區域, 子項目]
+const region = computed(() => {
+  const parent = route.matched[route.matched.length - 2]
+  return String(parent?.meta?.title ?? '')
+})
+const entry = computed(() => loginPreviews[String(route.name ?? '')])
+const noLogin = computed(() => entry.value === NO_LOGIN)
+const preview = computed(() => (entry.value && !noLogin.value ? entry.value : ''))
+</script>
